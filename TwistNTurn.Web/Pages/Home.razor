        <div class="modal-card settings-modal-card" role="dialog" aria-modal="true" aria-labelledby="files-modal-title" @onclick:stopPropagation="true">
            <h2 id="files-modal-title" class="modal-title">Import, Export &amp; Print</h2>
            <div class="modal-body settings-modal-body">
                <div class="settings-section">
                    <h3 class="settings-section-title">Export &amp; Print</h3>
                    <div class="files-btn-grid">
                        <button class="btn btn-secondary" @onclick='() => DownloadExportAsync("twist")' disabled="@(Game.CurrentMesh == null)">💾 Download .twist</button>
                        <button class="btn btn-secondary" @onclick='() => CopyExportAsync("twist")' disabled="@(Game.CurrentMesh == null)">📋 Copy .twist</button>
                        @if (Game.CanExportSquareFormats)
                        {
                            <button class="btn btn-secondary" @onclick='() => DownloadExportAsync("ascii")'>📝 Download .txt (ASCII)</button>
                            <button class="btn btn-secondary" @onclick='() => CopyExportAsync("ascii")'>📋 Copy ASCII</button>
                            <button class="btn btn-secondary" @onclick='() => CopyExportAsync("pearl-desc")'>📋 Copy Pearl Code</button>
                        }
                        <button class="btn btn-primary" @onclick="PrintBoardAsync" disabled="@(Game.CurrentMesh == null)">🖨️ Print Board</button>
                    </div>
                </div>

                <div class="settings-section">
                    <h3 class="settings-section-title">Import Puzzle</h3>
                    <p class="settings-hint">Supports <code>.twist</code>, ASCII grids (<code>+</code>, <code>O</code>, <code>*</code>, <code>-</code>, <code>|</code>), Pearl descriptors (<code>11x11:...</code>), or share links.</p>

                    <label class="files-file-row">
                        <span>Load from file:</span>
                        <InputFile OnChange="OnImportFileSelected" accept=".twist,.txt" />
                    </label>

                    <textarea class="files-textarea"
                              rows="5"
                              @bind="importText"
                              @bind:event="oninput"
                              placeholder="Paste puzzle file contents, Pearl code, ASCII grid, or share link here..."></textarea>

                    <div class="files-import-actions">
                        <button class="btn btn-primary" @onclick="ImportPuzzleFromTextAsync" disabled="@string.IsNullOrWhiteSpace(importText)">
                            Import Puzzle
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(filesStatusMessage))
                {
                    <div class="files-feedback @(filesStatusIsError ? "error" : "success")">
                        @filesStatusMessage
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="() => showFilesModal = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private const float S = 50.0f; // Scale factor: 50 pixels per grid unit

    private sealed class MeshGeometryCache
    {
        public required Mesh Source { get; init; }
        public float BaseW { get; init; }
        public float BaseH { get; init; }
        public float CenterX { get; init; }
        public float CenterY { get; init; }
        public required string[] CellPolygons { get; init; }
        public required (float Cx, float Cy, bool Valid)[] CellCentroids { get; init; }
        public required (float X1, float Y1, float X2, float Y2)[] EdgeExtents { get; init; }
        public required string[] EdgeX1Str { get; init; }
        public required string[] EdgeY1Str { get; init; }
        public required string[] EdgeX2Str { get; init; }
        public required string[] EdgeY2Str { get; init; }
    }

    private MeshGeometryCache? geometryCache;

    private static string FmtViewBox(float x, float y, float w, float h)
        => string.Create(CultureInfo.InvariantCulture, $"{x:F1} {y:F1} {w:F1} {h:F1}");

    private MeshGeometryCache GetOrBuildGeometryCache(Mesh mesh)
    {
        if (geometryCache != null && ReferenceEquals(geometryCache.Source, mesh))
            return geometryCache;

        float minX = float.MaxValue, minY = float.MaxValue, maxX = float.MinValue, maxY = float.MinValue;
        foreach (var inters in mesh.Intersections)
        {
            float x = inters.X * S;
            float y = inters.Y * S;
            if (x < minX) minX = x;
            if (y < minY) minY = y;
            if (x > maxX) maxX = x;
            if (y > maxY) maxY = y;
        }

        if (mesh.Intersections.Count == 0)
        {
            minX = minY = 0;
            maxX = maxY = 100;
        }

        float pad = 35.0f;
        float baseW = (maxX - minX) + pad * 2;
        float baseH = (maxY - minY) + pad * 2;
        if (baseW < 10) baseW = 100;
        if (baseH < 10) baseH = 100;

        var cellPolygons = new string[mesh.Cells.Count];
        var cellCentroids = new (float Cx, float Cy, bool Valid)[mesh.Cells.Count];
        var sb = new System.Text.StringBuilder();
        for (int c = 0; c < mesh.Cells.Count; c++)
        {
            var cell = mesh.Cells[c];
            sb.Clear();
            float sumX = 0, sumY = 0;
            for (int k = 0; k < cell.Intersections.Count; k++)
            {
                var inter = mesh.Intersections[cell.Intersections[k]];
                float px = inter.X * S;
                float py = inter.Y * S;
                sumX += px;
                sumY += py;
                if (k > 0) sb.Append(' ');
                sb.AppendFormat(CultureInfo.InvariantCulture, "{0:F1},{1:F1}", px, py);
            }
            cellPolygons[c] = sb.ToString();
            cellCentroids[c] = cell.Intersections.Count > 0
                ? (sumX / cell.Intersections.Count, sumY / cell.Intersections.Count, true)
                : (0f, 0f, false);
        }

        var edgeExtents = new (float X1, float Y1, float X2, float Y2)[mesh.Edges.Count];
        var edgeX1Str = new string[mesh.Edges.Count];
        var edgeY1Str = new string[mesh.Edges.Count];
        var edgeX2Str = new string[mesh.Edges.Count];
        var edgeY2Str = new string[mesh.Edges.Count];
        for (int e = 0; e < mesh.Edges.Count; e++)
        {
            mesh.GetEdgeExtent(mesh.Edges[e], out float rx1, out float ry1, out float rx2, out float ry2);
            float sx1 = rx1 * S, sy1 = ry1 * S, sx2 = rx2 * S, sy2 = ry2 * S;
            edgeExtents[e] = (sx1, sy1, sx2, sy2);
            edgeX1Str[e] = sx1.ToString("0.#", CultureInfo.InvariantCulture);
            edgeY1Str[e] = sy1.ToString("0.#", CultureInfo.InvariantCulture);
            edgeX2Str[e] = sx2.ToString("0.#", CultureInfo.InvariantCulture);
            edgeY2Str[e] = sy2.ToString("0.#", CultureInfo.InvariantCulture);
        }

        geometryCache = new MeshGeometryCache
        {
            Source = mesh,
            BaseW = baseW,
            BaseH = baseH,
            CenterX = (minX + maxX) / 2.0f,
            CenterY = (minY + maxY) / 2.0f,
            CellPolygons = cellPolygons,
            CellCentroids = cellCentroids,
            EdgeExtents = edgeExtents,
            EdgeX1Str = edgeX1Str,
            EdgeY1Str = edgeY1Str,
            EdgeX2Str = edgeX2Str,
            EdgeY2Str = edgeY2Str
        };
        return geometryCache;
    }

    private string selectedType = "Square";
    private bool showVictoryModal = false;
    private bool showHelpModal = false;
    private bool showSolveModal = false;
    private bool showResetModal = false;
    private bool showSettingsModal = false;
    private bool showFilesModal = false;
    private string importText = string.Empty;
    private string? filesStatusMessage;
    private bool filesStatusIsError = false;
    private bool isDarkMode = false;
    private bool showShareToast = false;
    private string toastMessage = "Link copied to clipboard!";
    private bool isMenuOpen = false;
    private bool hasPwaUpdate = false;
    private bool suppressNextVictoryModal = false;
    private bool boardJsInitialized = false;
    private volatile bool disposed = false;

    private bool IsAnyModalOpen => showHelpModal || showSolveModal || showResetModal || showSettingsModal || showFilesModal || (Game.IsSolved && showVictoryModal);

    private bool isVisualSolvePlaying = false;
    private int visualSolveSpeedMs = 220;
    private CancellationTokenSource? visualSolveCts;

    private const double WheelUndoRedoStepThreshold = 40.0;
    private double wheelDeltaAccumulator = 0;

    private static readonly string[] EdgeGroupPalette =
    [
        "#2563eb",
        "#d97706",
        "#059669",
        "#db2777",
        "#7c3aed",
        "#0891b2",
        "#dc2626",
        "#65a30d"
    ];

    private float zoomScale = 1.0f;
    private float panX = 0f;
    private float panY = 0f;

    private bool isPointerDown = false;
    private EdgeState? dragTargetState = null;
    private int lastClosestEdge = -1;
    private int lastClosestCell = -1;
    private bool speculativeFirstTouchToggled = false;
    private int draggedEdgesCount = 0;
    private IDisposable? timer;
    private DotNetObjectReference<Home>? selfRef;
    private CancellationTokenSource? shareToastCts;

    protected override void OnInitialized()
    {
        selfRef = DotNetObjectReference.Create(this);
        Game.OnStateChanged += HandleStateChanged;
        Game.OnBoardPersistedStateChanged += HandleBoardPersistedStateChanged;
        // Timer ONLY updates UI while generating (for the 10s cancel hint). Gameplay clock is isolated in <GameTimer />.
        timer = new System.Threading.Timer(_ =>
        {
            if (!disposed && Game.IsGenerating)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (selfRef != null)
            {
                await SafeInvokeVoidAsync("registerTwistShortcuts", selfRef);
            }

            try
            {
                string theme = await JS.InvokeAsync<string>("twistHelpers.getTheme");
                isDarkMode = (theme == "dark");
            }
            catch {}

            // Restore persisted user preferences before loading/generating puzzle
            try
            {
                string? settingsJson = await JS.InvokeAsync<string?>("twistHelpers.loadSettings");
                if (!string.IsNullOrEmpty(settingsJson))
                {
                    var prefs = JsonSerializer.Deserialize(settingsJson, TwistJsonContext.Default.UserPreferences);
                    if (prefs != null)
                        Game.ApplyPreferences(prefs);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to restore settings: {ex.Message}");
            }
            await SyncWheelModeAsync();

            bool loaded = false;
            suppressNextVictoryModal = true;
            try
            {
                // 1. Check URL hash for shared puzzle (#p=... or #puzzle=...)
                try
                {
                    string hash = await JS.InvokeAsync<string>("twistHelpers.getUrlHash");
                    if (!string.IsNullOrEmpty(hash))
                    {
                        loaded = await TryLoadPuzzleFromHashAsync(hash);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to load puzzle from hash: {ex.Message}");
                }

                // 2. Check localStorage if no hash loaded
                if (!loaded)
                {
                    loaded = await TryRestoreFromLocalStorageAsync();
                }
            }
            finally
            {
                lastSolvedState = Game.IsSolved;
                suppressNextVictoryModal = false;
            }

            // 3. Fallback to generating fresh puzzle
            if (!loaded)
            {
                await GeneratePuzzle();
            }
            else
            {
                ResetZoom();
                StateHasChanged();
                await InitBoardJsAsync();
            }
        }
        else if (Game.CurrentMesh != null && !boardJsInitialized)
        {
            await InitBoardJsAsync();
        }
