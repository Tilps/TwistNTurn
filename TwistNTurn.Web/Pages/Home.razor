    [JSInvokable]
    public void OnTwoFingerPanZoom(double svgDx, double svgDy, double scale)
    {
        if (!double.IsFinite(svgDx) || !double.IsFinite(svgDy) || !double.IsFinite(scale))
            return;
        panX -= (float)svgDx;
        panY -= (float)svgDy;
        if (scale > 0 && Math.Abs(scale - 1.0) > 0.001)
        {
            zoomScale = Math.Clamp(zoomScale * (float)scale, 0.4f, 8.0f);
        }
        StateHasChanged();
    }

