@page "/"
@using System.Globalization
@using System.Text.Json
@inject GameService Game
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Twist 'n' Turn - Masyu Logic Puzzle Game</PageTitle>

<div class="game-container">
    @if (hasPwaUpdate)
    {
        <div class="update-banner">
            <span>✨ A new version is available!</span>
            <button class="btn" @onclick="ReloadFromServer">Update Now</button>
            <button class="btn" style="background:transparent;color:#ffffff;" @onclick="() => hasPwaUpdate = false" aria-label="Dismiss update banner">✕</button>
        </div>
    }

    <!-- Header / Controls -->
    <header class="game-header">
        <!-- Persistent Action Bar: Undo, Redo, Fix, Unfix, Revert, Timer, Menu Toggle -->
        <div class="action-bar">
            <div class="action-buttons-group">
                <button class="btn btn-secondary action-btn undo-btn" @onclick="Game.Undo" disabled="@(!Game.CanUndo || Game.IsGenerating || Game.IsBusy)" title="Undo (Ctrl+Z)" aria-label="Undo">
                    <span class="btn-icon" aria-hidden="true">↶</span><span class="btn-text">Undo</span>
                </button>
                <button class="btn btn-secondary action-btn redo-btn" @onclick="Game.Redo" disabled="@(!Game.CanRedo || Game.IsGenerating || Game.IsBusy)" title="Redo (Ctrl+Y)" aria-label="Redo">
                    <span class="btn-icon" aria-hidden="true">↷</span><span class="btn-text">Redo</span>
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.Fix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Save Checkpoint (Ctrl+F)">
                    Fix
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.Unfix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Clear Checkpoint (Ctrl+U)">
                    Unfix
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.RevertToFix" disabled="@(Game.CurrentMesh == null || !Game.UndoTree.CanRevert || Game.IsGenerating || Game.IsBusy)" title="Revert to Checkpoint (Ctrl+R)">
                    Revert
                </button>
            </div>

            <div class="action-meta-group">
                <GameTimer />

                <!-- Desktop Utilities (Share, Files, Settings, Theme, Help, Reload) -->
                <div class="desktop-utility-group">
                    <button class="btn btn-secondary" @onclick="SharePuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Copy shareable link to this puzzle">
                        🔗 Share
                    </button>
                    <button class="btn btn-secondary" @onclick="OpenFilesModal" disabled="@(Game.IsGenerating || Game.IsBusy)" title="Import, Export, or Print puzzle">
                        📁 Files
                    </button>
                    <button class="btn btn-secondary" @onclick="OpenSettings" title="Game Settings &amp; Auto-Move">
                        ⚙️ Settings
                    </button>
                    <button class="btn btn-secondary" @onclick="ToggleTheme" title="Toggle Dark/Light Mode" aria-label="Toggle Dark or Light Mode">
                        @(isDarkMode ? "☀️" : "🌙")
                    </button>
                    <button class="btn btn-secondary" @onclick="() => showHelpModal = true" title="Instructions &amp; Rules">
                        Help
                    </button>
                    <button class="btn btn-secondary" @onclick="ReloadFromServer" title="Reload newest version from server" aria-label="Reload newest version">
                        🔄
                    </button>
                </div>

                <!-- Mobile Menu / Options Toggle -->
                <button class="btn btn-secondary menu-toggle-btn @(isMenuOpen ? "active" : "")" @onclick="() => isMenuOpen = !isMenuOpen" title="Puzzle Options &amp; Setup" aria-label="Toggle options menu" aria-expanded="@isMenuOpen">
                    @(isMenuOpen ? "✕" : "⚙️")
                </button>
            </div>
        </div>

        <!-- Collapsible Options Panel (Hidden on mobile by default, expanded via ⚙️; Always visible on desktop) -->
        <div class="header-collapsible @(isMenuOpen ? "open" : "")">
            <div class="brand">
                <h1 class="brand-title">Twist 'n' Turn</h1>
                <button class="mobile-close-btn" @onclick="() => isMenuOpen = false" title="Close Options" aria-label="Close options">✕</button>
            </div>

            <div class="controls-group">
                <div class="control-item">
                    <label for="grid-type-select">Grid:</label>
                    <select id="grid-type-select" class="select-input" value="@selectedType" @onchange="OnTypeChanged" disabled="@(Game.IsGenerating || Game.IsBusy)">
                        <option value="Square">Square</option>
                        <option value="SquareSymmetrical">Square Symmetrical</option>
                        <option value="Hexagonal2">Hexagon 2</option>
                        <option value="Hexagonal3">Hexagon 3</option>
                        <option value="Hexagonal4">Hexagon 4</option>
                    </select>
                </div>

                <div class="control-item">
                    <label for="grid-size-input">Size:</label>
                    <input id="grid-size-input" type="text" class="text-input" @bind="Game.SizeText" placeholder="10x10" disabled="@(Game.IsGenerating || Game.IsBusy)" />
                </div>

                <div class="control-item">
                    <label for="difficulty-select">Difficulty:</label>
                    <select id="difficulty-select" class="select-input" @bind="Game.Difficulty" disabled="@(Game.IsGenerating || Game.IsBusy)">
                        <option value="0">Trivial</option>
                        <option value="1">Easy</option>
                        <option value="2">Easyish</option>
                        <option value="3">Moderate</option>
                        <option value="4">Maybe Harder</option>
                        <option value="5">Unlimited</option>
                    </select>
                </div>

                <button class="btn btn-primary" @onclick="OnNewPuzzleClicked" disabled="@(Game.IsGenerating || Game.IsBusy)">
                    @if (Game.IsGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>New Puzzle</span>
                    }
                </button>
                <button class="btn btn-secondary" @onclick="PromptResetPuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Clear board and restart current puzzle">
                    Reset
                </button>
                <button class="btn btn-secondary" @onclick="RequestHintAsync" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Highlight a logical deduction edge without revealing whether it is a line or cross (Ctrl+H)">
                    💡 Hint
                </button>
                <button class="btn btn-secondary" @onclick="RequestDoHintAsync" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Highlight AND apply a logical next move (Ctrl+Shift+H)">
                    ⚡ Do Hint
                </button>
                <button class="btn @(Game.ShowHintHeatMap ? "btn-heatmap-active" : "btn-secondary")"
                        @onclick="ToggleHintHeatMapAsync"
                        disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)"
                        aria-pressed="@Game.ShowHintHeatMap"
                        title="Highlight the most promising areas to examine next">
                    🔥 Heat Map
                </button>
                <button class="btn btn-danger-outline" @onclick="PromptSolvePuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Reveal full solution">
                    ✨ Solve
                </button>
            </div>

            <div class="controls-group">
                <label class="checkbox-label" title="Disallow moves that cause obvious rule violations (degree > 2 or contradictory turns)">
                    <input type="checkbox" @bind="Game.DisallowFalseMove" @bind:after="OnSettingsChangedAsync" />
                    <span>Restrict invalid</span>
                </label>
                <label class="checkbox-label" title="Enable cell coloring for loop parity marking (when off, clicking inside routes to nearest edge)">
                    <input type="checkbox" @bind="Game.ShowCellColors" @bind:after="OnSettingsChangedAsync" />
                    <span>Cell shading</span>
                </label>
            </div>

            <!-- Mobile Utility Group (Shown inside collapsible menu on mobile) -->
            <div class="mobile-utility-group">
                <button class="btn btn-secondary" @onclick="SharePuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Copy shareable link to this puzzle">
                    🔗 Share
                </button>
                <button class="btn btn-secondary" @onclick="OpenFilesModal" disabled="@(Game.IsGenerating || Game.IsBusy)" title="Import, Export, or Print puzzle">
                    📁 Files
                </button>
                <button class="btn btn-secondary" @onclick="OpenSettings" title="Game Settings &amp; Auto-Move">
                    ⚙️ Settings
                </button>
                <button class="btn btn-secondary" @onclick="ToggleTheme" title="Toggle Dark/Light Mode">
                    @(isDarkMode ? "☀️ Light" : "🌙 Dark")
                </button>
                <button class="btn btn-secondary" @onclick="() => showHelpModal = true" title="Instructions &amp; Rules">
                    Help
                </button>
                <button class="btn btn-secondary" @onclick="ReloadFromServer" title="Reload newest version from server">
                    🔄 Reload
                </button>
            </div>
        </div>
    </header>

    <!-- Main Game Board -->
    <main class="board-container">
        @if (Game.IsGenerating || Game.IsBusy)
        {
            <div class="overlay-spinner" role="status" aria-live="polite">
                <div class="spinner"></div>
                <div class="spinner-content">
                    <div class="spinner-text">
                        @if (Game.IsBusy && !string.IsNullOrEmpty(Game.BusyMessage))
                        {
                            <span>@Game.BusyMessage</span>
                        }
                        else if (Game.PrunedProgress > 0 && Game.TotalIntersections > 0)
                        {
                            <span>Pruning pearls... (@Game.PrunedProgress / @Game.TotalIntersections checked)</span>
                        }
                        else
                        {
                            <span>Generating initial loop...</span>
                        }
                    </div>
                    @if (Game.IsGenerating && Game.PrunedProgress > 0 && Game.TotalIntersections > 0)
                    {
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: @(Math.Clamp((double)Game.PrunedProgress / Game.TotalIntersections * 100, 0, 100).ToString("F0", CultureInfo.InvariantCulture))%"></div>
                        </div>
                    }

                    @if (Game.IsGenerating && Game.GenerationElapsedSeconds >= 10)
                    {
                        <div class="generation-timeout-hint">
                            Generation is taking longer than usual (@($"{(int)Game.GenerationElapsedSeconds}s"))...
                        </div>
                        <button class="cancel-gen-btn" @onclick="Game.CancelGeneration" title="Cancel generation and keep existing board">
                            ✕ Cancel Generation
                        </button>
                    }
                </div>
            </div>
        }

        @if (Game.CurrentMesh != null)
        {
            var mesh = Game.CurrentMesh;
            var geom = GetOrBuildGeometryCache(mesh);

            float curW = geom.BaseW / zoomScale;
            float curH = geom.BaseH / zoomScale;

            float effX = geom.CenterX - (curW / 2.0f) + panX;
            float effY = geom.CenterY - (curH / 2.0f) + panY;

            float vertexRadius = 3.5f;
            float pearlRadius = 11.0f;
            EdgeState[]? vsEdgeStates = Game.CurrentVisualSolveStep?.EdgeStates;

            <svg id="game-board-svg" class="svg-board" viewBox="@FmtViewBox(effX, effY, curW, curH)" preserveAspectRatio="xMidYMid meet">
                <!-- Layer 1: Cell backgrounds (for interior/exterior shading; skip uncolored cells) -->
                <g class="cells-layer" style="pointer-events: none;">
                    @for (int c = 0; c < mesh.Cells.Count; c++)
                    {
                        var cell = mesh.Cells[c];
                        if (cell.Color == 0) continue;

                        string cellFill = cell.Color == 1 ? "var(--cell-yellow)" : "var(--cell-gray)";
                        <polygon points="@geom.CellPolygons[c]"
                                 fill="@cellFill"
                                 class="cell-poly"
                                 style="pointer-events: none;" />
                    }
                </g>

                <!-- Layer 2: Empty Grid Edges (faint background guidelines + loop grouping colors) -->
                <g class="empty-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        int edgeIdx = e;
                        var edge = mesh.Edges[edgeIdx];
                        EdgeState displayState = vsEdgeStates != null && edgeIdx < vsEdgeStates.Length ? vsEdgeStates[edgeIdx] : edge.State;
                        if (displayState == EdgeState.Empty)
                        {
                            mesh.GetEdgeExtent(edge, out float rawX1, out float rawY1, out float rawX2, out float rawY2);
                            float x1 = rawX1 * S, y1 = rawY1 * S, x2 = rawX2 * S, y2 = rawY2 * S;
                            if (vsEdgeStates == null && Game.ShowEdgeColors && edge.Color != 0)
                            {
                                string? dashArray = edge.Color < 0 ? "5 4" : null;
                                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                      class="edge-grouped"
                                      stroke="@GetEdgeGroupColor(edge.Color)"
                                      stroke-dasharray="@dashArray"
                                      style="pointer-events: none;" />
                            }
                            else
                            {
                                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                      class="edge-empty"
                                      style="pointer-events: none;" />
                            }
                        }

                        if (vsEdgeStates == null && Game.PendingGroupEdgeIndex == edgeIdx)
                        {
                            mesh.GetEdgeExtent(edge, out float px1, out float py1, out float px2, out float py2);
                            <line x1="@(px1 * S)" y1="@(py1 * S)" x2="@(px2 * S)" y2="@(py2 * S)"
                                  class="edge-group-pending"
                                  style="pointer-events: none;" />
                        }
                    }
                </g>

                <!-- Layer 2b: Hint Heat Map (warm glow on high-priority empty edges) -->
                @if (Game.ShowHintHeatMap && !Game.IsVisualSolving && !Game.IsSolved && Game.EdgeHeatScores is { } heatScores && heatScores.Length == mesh.Edges.Count)
                {
                    <g class="heatmap-layer" style="pointer-events: none;">
                        @for (int e = 0; e < mesh.Edges.Count; e++)
                        {
                            float heat = heatScores[e];
                            if (heat >= HeatMapMinThreshold && mesh.Edges[e].State == EdgeState.Empty)
                            {
                                int bucket = GetHeatBucket(heat);
                                <line @key="e"
                                      x1="@geom.EdgeX1Str[e]" y1="@geom.EdgeY1Str[e]" x2="@geom.EdgeX2Str[e]" y2="@geom.EdgeY2Str[e]"
                                      stroke="@(isDarkMode ? HeatColorsDark[bucket] : HeatColorsLight[bucket])"
                                      stroke-width="@HeatStrokeWidths[bucket]"
                                      stroke-opacity="@(isDarkMode ? HeatOpacitiesDark[bucket] : HeatOpacitiesLight[bucket])"
                                      class="edge-heatmap"
                                      style="pointer-events: none;" />
                            }
                        }
                    </g>
                }

                <!-- Layer 3: Active Edges (Filled loops & Excluded cross marks) -->
                <g class="active-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        int edgeIdx = e;
                        var edge = mesh.Edges[edgeIdx];
                        EdgeState displayState = vsEdgeStates != null && edgeIdx < vsEdgeStates.Length ? vsEdgeStates[edgeIdx] : edge.State;
                        if (displayState != EdgeState.Empty)
                        {
                            mesh.GetEdgeExtent(edge, out float rawX1, out float rawY1, out float rawX2, out float rawY2);
                            float x1 = rawX1 * S, y1 = rawY1 * S, x2 = rawX2 * S, y2 = rawY2 * S;
                            bool isMarked = vsEdgeStates == null && Game.MarkedEdges.Contains(edgeIdx);

                            if (displayState == EdgeState.Filled)
                            {
                                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                      class="@(isMarked ? "edge-filled-marked" : "edge-filled")"
                                      style="pointer-events: none;" />
                            }
                            else if (displayState == EdgeState.Excluded)
                            {
                                float mx = (x1 + x2) / 2.0f;
                                float my = (y1 + y2) / 2.0f;
                                float edx = x2 - x1;
                                float edy = y2 - y1;
                                float elen = MathF.Sqrt(edx * edx + edy * edy);
                                if (elen < 1e-4f) elen = 1.0f;
                                float ux = edx / elen;
                                float uy = edy / elen;
                                float vx = -uy;
                                float vy = ux;

                                float r = 3.6f;
                                float o1x = r * (ux + vx);
                                float o1y = r * (uy + vy);
                                float o2x = r * (ux - vx);
                                float o2y = r * (uy - vy);

                                string crossClass = isMarked ? "edge-cross-marked" : "edge-cross";
                                <line x1="@(mx - o1x)" y1="@(my - o1y)" x2="@(mx + o1x)" y2="@(my + o1y)"
                                      class="@crossClass"
                                      style="pointer-events: none;" />
                                <line x1="@(mx - o2x)" y1="@(my - o2y)" x2="@(mx + o2x)" y2="@(my + o2y)"
                                      class="@crossClass"
                                      style="pointer-events: none;" />
                            }
                        }
                    }
                </g>

                <!-- Layer 4: Intersections & Pearl Clues (Masyu Twist & Turn pearls) -->
                <g class="intersections-layer" style="pointer-events: none;">
                    @for (int i = 0; i < mesh.Intersections.Count; i++)
                    {
                        var inters = mesh.Intersections[i];
                        float ix = inters.X * S;
                        float iy = inters.Y * S;

                        if (inters.Type == IntersType.Twist)
                        {
                            <!-- White Pearl (Twist): Loop goes straight through, turns on adjacent vertex -->
                            <circle cx="@ix" cy="@iy" r="@pearlRadius" class="pearl-twist" style="pointer-events: none;" />
                        }
                        else if (inters.Type == IntersType.Turn)
                        {
                            <!-- Black Pearl (Turn): Loop turns 90 degrees here, goes straight on adjacent vertices -->
                            <circle cx="@ix" cy="@iy" r="@pearlRadius" class="pearl-turn" style="pointer-events: none;" />
                        }
                        else
                        {
                            <!-- Empty Intersection Vertex Dot -->
                            <circle cx="@ix" cy="@iy" r="@vertexRadius" class="vertex-dot" style="pointer-events: none;" />
                        }
                    }
                </g>

                <!-- Layer 5: Transient Invalid & Hint Highlights -->
                <g class="highlights-layer" style="pointer-events: none;">
                    @if (Game.InvalidEdgeIndex is int invIdx && invIdx >= 0 && invIdx < mesh.Edges.Count)
                    {
                        mesh.GetEdgeExtent(mesh.Edges[invIdx], out float rx1, out float ry1, out float rx2, out float ry2);
                        <line x1="@(rx1 * S)" y1="@(ry1 * S)" x2="@(rx2 * S)" y2="@(ry2 * S)"
                              class="edge-invalid-highlight"
                              style="pointer-events: none;" />
                    }

                    @if (Game.HintEdgeIndex is int hintIdx && hintIdx >= 0 && hintIdx < mesh.Edges.Count)
                    {
                        mesh.GetEdgeExtent(mesh.Edges[hintIdx], out float rx1, out float ry1, out float rx2, out float ry2);
                        float hx1 = rx1 * S, hy1 = ry1 * S, hx2 = rx2 * S, hy2 = ry2 * S;
                        @if (!Game.HintIsApplied)
                        {
                            <line x1="@hx1" y1="@hy1" x2="@hx2" y2="@hy2"
                                  class="edge-hint-neutral"
                                  style="pointer-events: none;" />
                        }
                        else if (Game.HintTargetState == EdgeState.Filled)
                        {
                            <line x1="@hx1" y1="@hy1" x2="@hx2" y2="@hy2"
                                  class="edge-hint-highlight"
                                  style="pointer-events: none;" />
                        }
                        else if (Game.HintTargetState == EdgeState.Excluded)
                        {
                            float mx = (hx1 + hx2) / 2.0f;
                            float my = (hy1 + hy2) / 2.0f;
                            float edx = hx2 - hx1;
                            float edy = hy2 - hy1;
                            float elen = MathF.Sqrt(edx * edx + edy * edy);
                            if (elen < 1e-4f) elen = 1.0f;
                            float ux = edx / elen;
                            float uy = edy / elen;
                            float vx = -uy;
                            float vy = ux;
                            float r = 5.5f;
                            float o1x = r * (ux + vx), o1y = r * (uy + vy);
                            float o2x = r * (ux - vx), o2y = r * (uy - vy);
                            <line x1="@(mx - o1x)" y1="@(my - o1y)" x2="@(mx + o1x)" y2="@(my + o1y)"
                                  class="edge-hint-cross"
                                  style="pointer-events: none;" />
                            <line x1="@(mx - o2x)" y1="@(my - o2y)" x2="@(mx + o2x)" y2="@(my + o2y)"
                                  class="edge-hint-cross"
                                  style="pointer-events: none;" />
                        }
                    }
                </g>
            </svg>

            @if (Game.IsVisualSolving && Game.CurrentVisualSolveStep is { } vsStep)
            {
                string badgeClass = vsStep.IsBacktrack ? "visual-solver-status backtrack" : (vsStep.IsBranching ? "visual-solver-status branch" : "visual-solver-status");
                <div class="visual-solver-bar" role="region" aria-label="Visual Solver Playback">
                    <div class="visual-solver-header">
                        <span class="visual-solver-step">Step @(Game.VisualSolveStepIndex + 1) / @Game.VisualSolveTotalSteps</span>
                        <span class="@badgeClass">@vsStep.Status</span>
                    </div>
                    <div class="visual-solver-controls">
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolveStart" disabled="@(Game.VisualSolveStepIndex <= 0)" title="Jump to start" aria-label="Jump to start">⏮</button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolvePrev" disabled="@(Game.VisualSolveStepIndex <= 0)" title="Previous step" aria-label="Previous step">◀</button>
                        <button class="btn btn-primary visual-solver-btn" @onclick="ToggleVisualSolvePlay" title="@(isVisualSolvePlaying ? "Pause" : "Play")">
                            @(isVisualSolvePlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolveNext" disabled="@(Game.VisualSolveStepIndex >= Game.VisualSolveTotalSteps - 1)" title="Next step" aria-label="Next step">▶</button>

                        <input type="range"
                               class="visual-solver-slider"
                               min="0"
                               max="@(Math.Max(0, Game.VisualSolveTotalSteps - 1))"
                               value="@Game.VisualSolveStepIndex"
                               @oninput="OnVisualSolveStepInput"
                               aria-label="Solver playback step" />

                        <select class="select-input visual-solver-speed" @bind="visualSolveSpeedMs" aria-label="Playback speed" title="Playback Speed">
                            <option value="450">0.5x</option>
                            <option value="220">1x</option>
                            <option value="110">2x</option>
                            <option value="45">5x</option>
                            <option value="15">Max</option>
                        </select>

                        <button class="btn btn-success visual-solver-btn" @onclick="ApplyVisualSolve" title="Apply complete solution to the board">✓ Apply</button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="DismissVisualSolve" title="Exit visual solver and return to your board" aria-label="Close visual solver">✕</button>
                    </div>
                </div>
            }

            @if (Game.ShowHintHeatMap && !Game.IsVisualSolving && !Game.IsSolved && Game.EdgeHeatScores != null)
            {
                <div class="heatmap-legend" role="status" aria-label="Hint heat map active">
                    <span class="heatmap-legend-label">🔥 Focus</span>
                    <span class="heatmap-legend-bar" aria-hidden="true"></span>
                    <span class="heatmap-legend-scale">Hot</span>
                    <button class="heatmap-legend-close" @onclick="ToggleHintHeatMapAsync" title="Turn off Heat Map" aria-label="Turn off Heat Map">✕</button>
                </div>
            }

            <!-- Floating Pan & Zoom Controls -->
            <div class="zoom-hud">
                <button class="zoom-btn" @onclick="() => ZoomBy(1.25f)" title="Zoom In (+)" aria-label="Zoom in">+</button>
                <button class="zoom-btn" @onclick="() => ZoomBy(0.8f)" title="Zoom Out (−)" aria-label="Zoom out">−</button>
                <button class="zoom-btn" @onclick="ResetZoom" title="Reset Pan &amp; Zoom" aria-label="Reset pan and zoom">⟲</button>
            </div>
        }
    </main>

    <!-- Footer Shortcuts Info -->
    <footer class="game-footer">
        <div>
            Shortcuts:
            <span class="shortcut-badge">Ctrl+Z</span> Undo &bull;
            <span class="shortcut-badge">Ctrl+Y</span> Redo &bull;
            <span class="shortcut-badge">Ctrl+F</span> Fix &bull;
            <span class="shortcut-badge">Ctrl+U</span> Unfix &bull;
            <span class="shortcut-badge">Ctrl+R</span> Revert &bull;
            <span class="shortcut-badge">Ctrl+H</span> Hint &bull;
            <span class="shortcut-badge">Ctrl+Shift+H</span> Do Hint
        </div>
        <div>
            Left-Click / Drag: Draw line &bull; Right-Click / Drag: Mark X &bull; Shift: Reverse cycle &bull; Fixed edges locked &bull; Two fingers / Wheel: Pan & Zoom
        </div>
    </footer>
</div>

@if (showShareToast)
{
    <div class="toast-notification" role="status" aria-live="polite">
        @toastMessage
    </div>
}

@if (!string.IsNullOrEmpty(Game.HintMessage))
{
    <div class="hint-toast-notification" role="status" aria-live="polite">
        <div class="hint-toast-content">
            <span class="hint-toast-icon" aria-hidden="true">💡</span>
            <span class="hint-toast-text">@Game.HintMessage</span>
        </div>
        <button class="hint-toast-close" @onclick="Game.ClearHint" title="Dismiss hint" aria-label="Dismiss hint">✕</button>
    </div>
}

<!-- Victory Modal -->
@if (Game.IsSolved && showVictoryModal)
{
    <div class="modal-backdrop">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="victory-modal-title">
            <div class="victory-badge">🏆</div>
            <h2 id="victory-modal-title" class="modal-title">Puzzle Solved!</h2>
            <div class="modal-body" style="text-align: center;">
                <p>Congratulations! You successfully solved the loop in <strong>@GameTimer.FormatElapsed(Game.ElapsedTime)</strong>!</p>
            </div>
            <div class="modal-actions" style="justify-content: center;">
                <button class="btn btn-secondary" @onclick="SharePuzzle">🔗 Share Link</button>
                <button class="btn btn-secondary" @onclick="() => showVictoryModal = false">Review Board</button>
                <button class="btn btn-success" @onclick="GeneratePuzzle">New Puzzle</button>
            </div>
        </div>
    </div>
}

<!-- Help / Rules Modal -->
@if (showHelpModal)
{
    <div class="modal-backdrop" @onclick="() => showHelpModal = false">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="help-modal-title" @onclick:stopPropagation="true">
            <h2 id="help-modal-title" class="modal-title">How to Play Twist 'n' Turn</h2>
            <div class="modal-body">
                <p><strong>Goal:</strong> Form a single continuous non-crossing loop along grid lines passing through every pearl clue.</p>
                <ul>
                    <li>
                        <strong>⚪ White Pearl (Twist):</strong> The loop must pass <em>straight</em> through this pearl, and must turn 90° in at least one of the intersections immediately before or after it.
                    </li>
                    <li>
                        <strong>⚫ Black Pearl (Turn):</strong> The loop must make a 90° <em>turn</em> at this pearl, and must travel straight through the intersections immediately before and after it.
                    </li>
                    <li>
                        <strong>Grid intersections without pearls:</strong> The loop may pass straight through, turn, or not visit them at all.
                    </li>
                    <li>
                        The loop cannot branch or cross itself — every visited intersection must have exactly 2 loop edges attached.
                    </li>
                </ul>
                <p><strong>Controls:</strong></p>
                <ul>
                    <li><strong>Left-Click or Drag</strong> on an edge: draw / cycle Empty ➔ Filled ➔ Excluded ➔ Empty.</li>
                    <li><strong>Right-Click or Drag</strong>: mark Excluded crosses (X).</li>
                    <li><strong>Shift + Click</strong>: reverses the cycling direction of left and right clicks.</li>
                    <li><strong>Clicking near cell center</strong>: automatically routes to the closest edge of the cell!</li>
                    <li><strong>Cell shading option</strong>: when enabled, clicking shades cells to assist with loop parity reasoning.</li>
                    <li><strong>Restrict invalid option</strong>: when enabled, moves causing obvious contradictions (e.g. vertex degree > 2) are blocked. When off (default), moves cycle freely.</li>
                    <li><strong>Two-Finger Touch / Wheel</strong>: Pan by dragging with two fingers (or middle-mouse drag); pinch to zoom (or use mouse wheel or HUD buttons). Single-finger drag remains for drawing lines!</li>
                    <li><strong>Share</strong>: Copy a compact URL link carrying the exact puzzle to share with friends.</li>
                    <li><strong>Fix (Ctrl+F)</strong>: Save a checkpoint (current moves turn green and become locked against accidental changes).</li>
                    <li><strong>Unfix (Ctrl+U)</strong>: Clear checkpoint and unlock fixed edges.</li>
                    <li><strong>Revert (Ctrl+R)</strong>: Rollback all moves made after your last checkpoint.</li>
                    <li><strong>Hint (Ctrl+H) &amp; Do Hint (Ctrl+Shift+H)</strong>: Hint highlights a logically deducible edge without spoiling whether it is a line or X; Do Hint applies it and explains why.</li>
                    <li><strong>Heat Map</strong>: Overlay a live warm glow showing the most productive regions of the board to examine next, without spoiling the move.</li>
                    <li><strong>Reset &amp; Solve</strong>: Reset clears your moves and restarts the current puzzle; Solve lets you reveal the full solution or step through it visually.</li>
                    <li><strong>Settings &amp; Auto-Move</strong>: Enable cascading auto-move deductions, Auto-start, scroll-wheel Undo/Redo, loop grouping (Alt/Ctrl+Click), or analyze puzzle difficulty.</li>
                    <li><strong>Files &amp; Print</strong>: Import/export <code>.twist</code>, ASCII grid, pearl descriptors, or print a clean sheet.</li>
                </ul>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="() => showHelpModal = false">Got it!</button>
            </div>
        </div>
    </div>
}

<!-- Solve Confirmation Modal -->
@if (showSolveModal)
{
    <div class="modal-backdrop" @onclick="() => showSolveModal = false">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="solve-modal-title" @onclick:stopPropagation="true">
            <h2 id="solve-modal-title" class="modal-title">Reveal Solution?</h2>
            <div class="modal-body" style="text-align: center;">
                <p>Watch the solver step through logical deductions and backtracking, or apply the complete solution immediately. (You can still Undo afterward.)</p>
            </div>
            <div class="modal-actions" style="justify-content: center; flex-wrap: wrap;">
                <button class="btn btn-secondary" @onclick="() => showSolveModal = false">Cancel</button>
                <button class="btn btn-primary" @onclick="StartVisualSolveAsync">👁️ Watch Solver</button>
                <button class="btn btn-danger" @onclick="ConfirmSolvePuzzleAsync">Solve Instantly</button>
            </div>
        </div>
    </div>
}

<!-- Reset Confirmation Modal -->
@if (showResetModal)
{
    <div class="modal-backdrop" @onclick="() => showResetModal = false">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="reset-modal-title" @onclick:stopPropagation="true">
            <h2 id="reset-modal-title" class="modal-title">Reset Puzzle?</h2>
