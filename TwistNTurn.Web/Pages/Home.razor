    private void StartVisualSolvePlayback()
    {
        StopVisualSolvePlayback();
        if (!Game.IsVisualSolving || Game.VisualSolveStepIndex >= Game.VisualSolveTotalSteps - 1)
            return;

        isVisualSolvePlaying = true;
        visualSolveCts = new CancellationTokenSource();
        _ = RunVisualSolvePlaybackAsync(visualSolveCts.Token);
    }

    private async Task RunVisualSolvePlaybackAsync(CancellationToken token)
    {
        try
        {
            while (!disposed && isVisualSolvePlaying && !token.IsCancellationRequested)
            {
                int delay = Math.Clamp(visualSolveSpeedMs, 15, 2000);
                await Task.Delay(delay, token);
                if (disposed || !isVisualSolvePlaying || token.IsCancellationRequested)
                    break;
                if (!Game.StepVisualSolveForward())
                {
                    StopVisualSolvePlayback();
                    StateHasChanged();
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopVisualSolvePlayback()
    {
        isVisualSolvePlaying = false;
        var cts = visualSolveCts;
        visualSolveCts = null;
        if (cts != null)
        {
            cts.Cancel();
            cts.Dispose();
        }
    }

