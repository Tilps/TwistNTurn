    private static float DistanceToSegmentSq(float px, float py, float sx, float sy, float ex, float ey)
    {
        float dx = ex - sx;
        float dy = ey - sy;
        float lenSq = dx * dx + dy * dy;
        if (lenSq == 0)
        {
            float ddx = px - sx;
            float ddy = py - sy;
            return ddx * ddx + ddy * ddy;
        }
        float t = Math.Clamp(((px - sx) * dx + (py - sy) * dy) / lenSq, 0.0f, 1.0f);
        float nearX = sx + t * dx;
        float nearY = sy + t * dy;
        float distx = nearX - px;
        float disty = nearY - py;
        return distx * distx + disty * disty;
    }

    private void FindClosest(float px, float py, out int closestEdge, out int closestCell, float minSep = 0.0f)
    {
        closestEdge = -1;
        closestCell = -1;
        if (Game.CurrentMesh == null) return;

        var geom = GetOrBuildGeometryCache(Game.CurrentMesh);
        float distanceSq = float.MaxValue;
        float secondDistanceSq = float.MaxValue;

        var edgeExtents = geom.EdgeExtents;
        for (int i = 0; i < edgeExtents.Length; i++)
        {
            var (x1, y1, x2, y2) = edgeExtents[i];
            float curDistSq = DistanceToSegmentSq(px, py, x1, y1, x2, y2);
            if (curDistSq <= distanceSq)
            {
                secondDistanceSq = distanceSq;
                distanceSq = curDistSq;
                closestEdge = i;
            }
            else if (curDistSq <= secondDistanceSq)
            {
                secondDistanceSq = curDistSq;
            }
        }

        if (Game.ShowCellColors)
        {
            var centroids = geom.CellCentroids;
            for (int c = 0; c < centroids.Length; c++)
            {
                if (!centroids[c].Valid) continue;
                float distx = centroids[c].Cx - px;
                float disty = centroids[c].Cy - py;
                float curDistSq = distx * distx + disty * disty;
                if (curDistSq <= distanceSq)
                {
                    closestEdge = -1;
                    closestCell = c;
                    secondDistanceSq = distanceSq;
                    distanceSq = curDistSq;
                }
                else if (curDistSq <= secondDistanceSq)
                {
                    secondDistanceSq = curDistSq;
                }
            }
        }

        // Ignore clicks too far away (> 1.2 grid units from any element)
        float maxAllowedSq = (1.2f * S) * (1.2f * S);
        if (distanceSq > maxAllowedSq)
        {
            closestEdge = -1;
            closestCell = -1;
            return;
        }

        if (minSep > 0 && distanceSq + 2 * minSep * MathF.Sqrt(distanceSq) + minSep * minSep > secondDistanceSq)
        {
            closestEdge = -1;
            closestCell = -1;
        }
    }

    [JSInvokable]
    public void OnSvgPointerDown(double x, double y, int button, bool shiftKey, bool ctrlKey = false, bool altKey = false)
    {
        if (Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy) return;

        float fx = (float)x;
        float fy = (float)y;
        FindClosest(fx, fy, out int closestEdge, out int closestCell, 0.0f);

        lastClosestEdge = closestEdge;
        lastClosestCell = closestCell;
        speculativeFirstTouchToggled = false;
        draggedEdgesCount = 0;

        bool isRight = button == 2; // Right click
        bool isAlt = shiftKey ? !isRight : isRight; // Shift reverses cycle direction

        if (closestEdge != -1)
        {
            if (Game.MarkedEdges.Contains(closestEdge))
                return; // Fixed edges cannot be clicked or changed

            if ((altKey || ctrlKey) && Game.ShowEdgeColors)
            {
                Game.HandleEdgeGroupingClick(closestEdge, sameLoop: altKey);
                return;
            }

            if (Game.ToggleEdge(closestEdge, isAlt))
            {
                isPointerDown = true;
                dragTargetState = Game.CurrentMesh.Edges[closestEdge].State;
                speculativeFirstTouchToggled = true;
            }
        }
        else if (closestCell != -1 && Game.ShowCellColors)
        {
            Game.ClearPendingEdgeGroup();
            if (Game.ToggleCellColor(closestCell, isAlt))
            {
                isPointerDown = true;
                speculativeFirstTouchToggled = true;
            }
        }
        else
        {
            Game.ClearPendingEdgeGroup();
        }
    }

    [JSInvokable]
    public void OnSvgPointerMove(double x, double y)
    {
        if (!isPointerDown || Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy) return;
        if (!dragTargetState.HasValue) return;

        float fx = (float)x;
        float fy = (float)y;
        float minSep = 8.0f; // 8px buffer to avoid edge flutter during drag
        FindClosest(fx, fy, out int closestEdge, out int closestCell, minSep);

        if (closestEdge != -1 && closestEdge != lastClosestEdge)
        {
            lastClosestEdge = closestEdge;
            if (!Game.MarkedEdges.Contains(closestEdge))
            {
                if (Game.SetEdgeDirect(closestEdge, dragTargetState.Value))
                    draggedEdgesCount++;
            }
        }
    }

    [JSInvokable]
    public void OnSvgPointerUp()
    {
        isPointerDown = false;
        dragTargetState = null;
        lastClosestEdge = -1;
        lastClosestCell = -1;
        speculativeFirstTouchToggled = false;
        draggedEdgesCount = 0;
    }

    [JSInvokable]
    public void OnRevertFirstTouch()
    {
        if (speculativeFirstTouchToggled && draggedEdgesCount == 0)
        {
            Game.UndoAndForget();
        }
        OnSvgPointerUp();
    }

    [JSInvokable]
    public async Task OnShortcut(string action)
    {
        if (action == "escape")
        {
            if (IsAnyModalOpen || isMenuOpen)
            {
                showHelpModal = false;
                showSolveModal = false;
                showResetModal = false;
                showSettingsModal = false;
                showFilesModal = false;
                showVictoryModal = false;
                isMenuOpen = false;
                StateHasChanged();
            }
            else if (Game.IsVisualSolving)
            {
                DismissVisualSolve();
            }
            else if (Game.PendingGroupEdgeIndex.HasValue)
            {
                Game.ClearPendingEdgeGroup();
            }
            return;
        }

        if (Game.IsGenerating || Game.IsBusy || Game.CurrentMesh == null || IsAnyModalOpen)
            return;

        switch (action)
        {
            case "undo": Game.Undo(); break;
            case "redo": Game.Redo(); break;
            case "fix": Game.Fix(); break;
            case "unfix": Game.Unfix(); break;
            case "revert": Game.RevertToFix(); break;
            case "hint": await RequestHintAsync(); break;
            case "dohint": await RequestDoHintAsync(); break;
        }
    }

    [JSInvokable]
    public void OnPwaUpdateAvailable()
    {
        if (disposed) return;
        hasPwaUpdate = true;
        StateHasChanged();
    }

    private async Task<bool> TryRestoreFromLocalStorageAsync(Func<SavedGameState, bool>? predicate = null)
    {
        try
        {
            string? savedJson = await JS.InvokeAsync<string?>("twistHelpers.loadGameState");
            if (string.IsNullOrEmpty(savedJson))
                return false;

            var savedState = JsonSerializer.Deserialize(savedJson, TwistJsonContext.Default.SavedGameState);
            if (savedState != null && (predicate == null || predicate(savedState)) && Game.RestoreState(savedState))
            {
                selectedType = Game.CurrentType.ToString();
                lastSolvedState = Game.IsSolved;
                return true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to restore local state: {ex.Message}");
        }
        return false;
    }

    private async Task HideShareToastAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2500, token);
            if (!disposed)
            {
                showShareToast = false;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SafeInvokeVoidAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS interop error ({identifier}): {ex.Message}");
        }
    }

    private async Task InitBoardJsAsync()
    {
        if (selfRef != null && Game.CurrentMesh != null)
        {
            try
            {
                boardJsInitialized = await JS.InvokeAsync<bool>("initTwistBoard", "game-board-svg", selfRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS interop error (initTwistBoard): {ex.Message}");
            }
        }
    }

    private async Task ReloadFromServer()
    {
        await SafeInvokeVoidAsync("twistHelpers.reloadFromServer");
    }

    public void Dispose()
    {
        disposed = true;
        StopVisualSolvePlayback();
        Game.OnStateChanged -= HandleStateChanged;
        Game.OnBoardPersistedStateChanged -= HandleBoardPersistedStateChanged;
        timer?.Dispose();
        timer = null;
        shareToastCts?.Cancel();
        shareToastCts?.Dispose();
        shareToastCts = null;
        _ = SafeInvokeVoidAsync("disposeTwistBoard");
        selfRef?.Dispose();
        selfRef = null;
    }
}

