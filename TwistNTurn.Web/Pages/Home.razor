    private async Task<bool> TryLoadPuzzleFromHashAsync(string? rawHash)
    {
        if (!GameService.TryExtractPuzzleHashPayload(rawHash, out string normalizedHash, out string code))
            return false;

        // A) Compact format or Pearl descriptor
        if (PuzzleCodec.TryDecode(code, out var decodedMesh, out int dw, out int dh, out _) && decodedMesh != null)
        {
            string canonical = PuzzleCodec.Encode(decodedMesh, dw, dh);
            bool restored = await TryRestoreFromLocalStorageAsync(s => s.Puzzle == canonical || s.Puzzle == code || s.Puzzle == normalizedHash);
            if (restored)
                return true;
            if (Game.LoadPuzzleText(code))
            {
                selectedType = Game.CurrentType.ToString();
                return true;
            }
            return false;
        }

        // B) Fallback for compressed URLs
        if (PuzzleCompression.TryDecompressFromUrlSafe(code, out string puzzleText) && !string.IsNullOrEmpty(puzzleText))
        {
            if (await TryRestoreFromLocalStorageAsync(s => s.Puzzle == puzzleText || s.Puzzle == normalizedHash))
                return true;
            if (Game.LoadPuzzleText(puzzleText))
            {
                selectedType = Game.CurrentType.ToString();
                return true;
            }
        }

        return false;
    }

    [JSInvokable]
    public async Task OnUrlHashChanged(string hash)
    {
        if (disposed || string.IsNullOrWhiteSpace(hash))
            return;

        if (Game.IsGenerating)
            Game.CancelGeneration();
        if (Game.IsBusy)
            return;

        suppressNextVictoryModal = true;
        try
        {
            bool loaded = await TryLoadPuzzleFromHashAsync(hash);
            if (loaded)
            {
                showVictoryModal = false;
                showSolveModal = false;
                showResetModal = false;
                showFilesModal = false;
                showSettingsModal = false;
                showHelpModal = false;
                isMenuOpen = false;
                lastSolvedState = Game.IsSolved;
                ResetZoom();
                ShowToast("Loaded shared puzzle!");
                StateHasChanged();
            }
            else if (hash.TrimStart('#').StartsWith("p=", StringComparison.OrdinalIgnoreCase) ||
                     hash.TrimStart('#').StartsWith("puzzle=", StringComparison.OrdinalIgnoreCase))
            {
                ShowToast("Could not load puzzle from link.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load puzzle from hash change: {ex.Message}");
        }
        finally
        {
            lastSolvedState = Game.IsSolved;
            suppressNextVictoryModal = false;
        }
    }

