}

<!-- Settings Modal -->
@if (showSettingsModal)
{
    <div class="modal-backdrop" @onclick="() => showSettingsModal = false">
        <div class="modal-card settings-modal-card" role="dialog" aria-modal="true" aria-labelledby="settings-modal-title" @onclick:stopPropagation="true">
            <h2 id="settings-modal-title" class="modal-title">Settings</h2>
            <div class="modal-body settings-modal-body">
                <div class="settings-section">
                    <h3 class="settings-section-title">Gameplay &amp; Auto-Move</h3>

                    <div class="settings-row">
                        <label class="settings-label" for="setting-automove">
                            <span>Auto-move deductions</span>
                            <small class="settings-hint">Automatically fill forced neighbor deductions after each move</small>
                        </label>
                        <select id="setting-automove" class="select-input" @bind="Game.AutoMoveLevel" @bind:after="OnSettingsChangedAsync">
                            <option value="0">Off (Default)</option>
                            <option value="1">Level 1 (Immediate)</option>
                            <option value="2">Level 2 (2-Step Cascade)</option>
                            <option value="3">Level 3 (Deep Cascade)</option>
                            <option value="4">Full Cascade</option>
                        </select>
                    </div>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.AutoMoveConsiderMultipleLoops" @bind:after="OnSettingsChangedAsync" />
                        <span>Avoid closing a partial loop prematurely in auto-move</span>
                    </label>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.AutoMoveUseColoring" @bind:after="OnSettingsChangedAsync" />
                        <span>Use loop coloring deductions in auto-move</span>
                    </label>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.AutoStart" @bind:after="OnSettingsChangedAsync" />
                        <span>Auto-start opening pearl deductions on new &amp; reset puzzles</span>
                    </label>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.DisallowFalseMove" @bind:after="OnSettingsChangedAsync" />
                        <span>Restrict invalid moves</span>
                    </label>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.ShowCellColors" @bind:after="OnSettingsChangedAsync" />
                        <span>Enable cell shading</span>
                    </label>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.ShowHintHeatMap" @bind:after="OnSettingsChangedAsync" />
                        <span>Show hint heat map (highlight best regions to inspect next)</span>
                    </label>
                </div>

                <div class="settings-section">
                    <h3 class="settings-section-title">Controls &amp; Display</h3>

                    <div class="settings-row">
                        <label class="settings-label" for="setting-wheel">
                            <span>Mouse wheel</span>
                            <small class="settings-hint">Ctrl + Wheel always zooms in Undo / Redo mode</small>
                        </label>
                        <select id="setting-wheel" class="select-input" @bind="Game.WheelMode" @bind:after="OnSettingsChangedAsync">
                            <option value="@MouseWheelMode.Zoom">Zoom In / Out (Default)</option>
                            <option value="@MouseWheelMode.UndoRedo">Undo / Redo</option>
                        </select>
                    </div>

                    <label class="settings-check-row">
                        <input type="checkbox" @bind="Game.ShowClock" @bind:after="OnSettingsChangedAsync" />
                        <span>Show elapsed timer</span>
                    </label>

                    <label class="settings-check-row desktop-only-setting" title="Desktop shortcut: Alt+Click two edges to link same loop color, Ctrl+Click to link opposite parity">
                        <input type="checkbox" @bind="Game.ShowEdgeColors" @bind:after="OnSettingsChangedAsync" />
                        <span>Desktop loop grouping (Alt+Click same, Ctrl+Click opposite)</span>
                    </label>
                </div>

                <div class="settings-section">
                    <div class="settings-row">
                        <div class="settings-label">
                            <span>Puzzle Inspector (On-Demand)</span>
                            <small class="settings-hint">Checks solvability tier &amp; pearl clue density without background CPU overhead</small>
                        </div>
                        <button class="btn btn-secondary" @onclick="AnalyzePuzzleAsync" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)">
                            🔍 Analyze Puzzle
                        </button>
                    </div>

                    @if (Game.CurrentAnalysis is { } analysis)
                    {
                        double density = analysis.TotalIntersections > 0 ? (double)analysis.ClueCount / analysis.TotalIntersections : 0;
                        <div class="analysis-card">
                            <div><strong>Status:</strong> @analysis.SolveStatus</div>
                            <div><strong>Rating:</strong> @analysis.TechniqueTier</div>
                            <div><strong>Branch Depth:</strong> @analysis.BranchDepth</div>
                            <div><strong>Pearls:</strong> @analysis.WhitePearls white, @analysis.BlackPearls black (@analysis.ClueCount / @analysis.TotalIntersections intersections, @($"{density:P0}")) &bull; @analysis.EdgeCount edges</div>
                        </div>
                    }
                </div>

                <details class="settings-advanced">
                    <summary class="settings-advanced-summary">Generator Tuning (Advanced)</summary>
                    <div class="settings-advanced-content">
                        <p class="settings-hint">Changes take effect when generating a new puzzle.</p>

                        <div class="settings-range-row">
                            <div class="settings-range-header">
                                <label for="setting-length">Target loop length</label>
                                <span class="settings-value-badge">@($"{Game.GenerateLengthFraction:P0}")</span>
                            </div>
                            <input id="setting-length" type="range" min="0.25" max="0.75" step="0.05"
                                   @bind="Game.GenerateLengthFraction" @bind:event="oninput" @bind:after="OnSettingsChangedAsync" />
                        </div>

                        <div class="settings-range-row">
                            <div class="settings-range-header">
                                <label for="setting-boring">Trivial clue cap (boring fraction)</label>
                                <span class="settings-value-badge">@($"{Game.GenerateBoringFraction:P0}")</span>
                            </div>
                            <input id="setting-boring" type="range" min="0.00" max="0.20" step="0.01"
                                   @bind="Game.GenerateBoringFraction" @bind:event="oninput" @bind:after="OnSettingsChangedAsync" />
                        </div>

                        <div class="settings-row">
                            <label class="settings-label" for="setting-solver">Generator solver mode</label>
                            <select id="setting-solver" class="select-input" @bind="Game.SolverModeOverride" @bind:after="OnSettingsChangedAsync">
                                <option value="@GeneratorSolverMode.Auto">Auto (By Difficulty)</option>
                                <option value="@GeneratorSolverMode.Iterative">Iterative</option>
                                <option value="@GeneratorSolverMode.Recursive">Recursive</option>
                            </select>
                        </div>

                        <label class="settings-check-row">
                            <input type="checkbox" @bind="Game.UseNeuralTrialOrdering" @bind:after="OnSettingsChangedAsync" />
                            <span>Use neural trial ordering (faster solving &amp; puzzle generation)</span>
                        </label>
                    </div>
                </details>
            </div>
            <div class="modal-actions settings-modal-actions">
                <button class="btn btn-secondary" @onclick="ResetSettingsToDefaultsAsync">Reset Defaults</button>
                <button class="btn btn-primary" @onclick="() => showSettingsModal = false">Done</button>
            </div>
        </div>
    </div>
}

