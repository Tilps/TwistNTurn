    [JSInvokable]
    public void OnWheelUndoRedo(double deltaY)
    {
        if (Game.IsGenerating || Game.CurrentMesh == null || deltaY == 0)
            return;

        if ((wheelDeltaAccumulator > 0 && deltaY < 0) || (wheelDeltaAccumulator < 0 && deltaY > 0))
            wheelDeltaAccumulator = 0;

        wheelDeltaAccumulator += deltaY;

        while (wheelDeltaAccumulator >= WheelUndoRedoStepThreshold)
        {
            wheelDeltaAccumulator -= WheelUndoRedoStepThreshold;
            Game.Undo();
        }

        while (wheelDeltaAccumulator <= -WheelUndoRedoStepThreshold)
        {
            wheelDeltaAccumulator += WheelUndoRedoStepThreshold;
            Game.Redo();
        }
    }

